#!/bin/bash
# omarchy theme-set hook: regenerate hunk's config.toml from the active theme.
# omarchy-hook executes hooks with `bash "$hook"`, so this is a bash wrapper
# that hands off to python3 (heredoc form keeps it one file).
python3 - "$@" <<'PY'
import shutil
import sys
import tomllib
from pathlib import Path

STATE_DIR = Path.home() / ".local/state/omarchy/current/theme"
THEME_NAME_FILE = Path.home() / ".local/state/omarchy/current/theme.name"
CONFIG = Path.home() / ".config/hunk/config.toml"

PREFERENCES = """
# Generated by ~/.config/omarchy/hooks/theme-set.d/30-hunk-theme from the
# active Omarchy theme. Do not edit by hand; edit the script instead (or add a
# repo-level .hunk/config.toml to overlay repo-specific settings).
"""


def hex2rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return tuple(int(h[i : i + 2], 16) for i in (0, 2, 4))


def blend(fg: str, bg: str, t: float) -> str:
    f, b = hex2rgb(fg), hex2rgb(bg)
    return "#" + "".join(f"{round(b[i] + (f[i] - b[i]) * t):02x}" for i in range(3))


def main() -> int:
    colors_path = STATE_DIR / "colors.toml"
    if not colors_path.exists():
        print("hunk-theme: no active Omarchy theme found, skipping")
        return 0

    with open(colors_path, "rb") as f:
        c = tomllib.load(f)

    name = ""
    if THEME_NAME_FILE.exists():
        name = THEME_NAME_FILE.read_text().strip()

    def val(*keys: str, default: str) -> str:
        for k in keys:
            if c.get(k):
                return c[k]
        return default

    dark = str(c.get("mode", "dark")).lower() == "dark"
    bg = val("background", default="#000000")
    fg = val("foreground", default="#ffffff")
    accent = val("accent", "blue", default=fg)
    green = val("green", default="#00ff00")
    red = val("red", default="#ff0000")
    yellow = val("yellow", default="#ffff00")
    cyan = val("cyan", default="#00ffff")
    magenta = val("magenta", default="#ff00ff")
    muted = val("muted", "dark_foreground", default="#888888")
    panel = val("dark_background", "background", default=bg)
    panel_alt = val("darker_background", "dark_background", default=panel)
    border = val("lighter_background", "muted", default=muted)
    selection = val("selection", default=blend(accent, bg, 0.25))
    line_num_fg = val("dark_foreground", "muted", default=muted)
    accent_muted = blend(accent, bg, 0.3)

    theme = {
        "base": "github-dark-default" if dark else "github-light-default",
        "label": f"Omarchy {name}".strip(),
        "background": bg,
        "panel": panel,
        "panelAlt": panel_alt,
        "border": border,
        "accent": accent,
        "accentMuted": accent_muted,
        "text": fg,
        "muted": muted,
        "addedBg": blend(green, bg, 0.15),
        "removedBg": blend(red, bg, 0.15),
        "movedAddedBg": blend(cyan, bg, 0.15),
        "movedRemovedBg": blend(magenta, bg, 0.15),
        "contextBg": bg,
        "addedContentBg": blend(green, bg, 0.30),
        "removedContentBg": blend(red, bg, 0.30),
        "contextContentBg": blend(fg, bg, 0.05),
        "addedSignColor": green,
        "removedSignColor": red,
        "lineNumberBg": panel,
        "lineNumberFg": line_num_fg,
        "selectedHunk": selection,
        "badgeAdded": green,
        "badgeRemoved": red,
        "badgeNeutral": muted,
        "fileNew": green,
        "fileDeleted": red,
        "fileRenamed": cyan,
        "fileModified": accent,
        "fileUntracked": yellow,
        "noteBorder": accent,
        "noteBackground": blend(accent, bg, 0.15),
        "noteTitleBackground": blend(accent, bg, 0.25),
        "noteTitleText": fg,
    }

    syntax_scopes = {
        "comment": muted,
        "punctuation.definition.comment": muted,
        "string": green,
        "string.quoted.double": green,
        "string.quoted.single": green,
        "string.regexp": green,
        "keyword": red,
        "keyword.control": red,
        "storage": red,
        "keyword.operator": cyan,
        "keyword.operator.arithmetic": cyan,
        "keyword.operator.logical": cyan,
        "entity.name.function": accent,
        "support.function": accent,
        "meta.function-call": fg,
        "constant.numeric": yellow,
        "constant.other": yellow,
        "constant.language": val("orange", default=yellow),
        "entity.name.type": yellow,
        "support.type": yellow,
        "variable": fg,
        "variable.other": fg,
        "punctuation": muted,
    }

    if CONFIG.exists() and not Path(str(CONFIG) + ".bak").exists():
        shutil.copy2(CONFIG, Path(str(CONFIG) + ".bak"))

    lines = [PREFERENCES.strip(), "", 'theme = "custom"', "transparent_background = true", ""]
    lines.append("[custom_theme]")
    for k, v in theme.items():
        lines.append(f'{k} = "{v}"')
    lines.append("")
    lines.append("[custom_theme.syntax_scopes]")
    for k, v in syntax_scopes.items():
        lines.append(f'"{k}" = "{v}"')
    lines.append("")

    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text("\n".join(lines), encoding="utf-8")
    print(f"hunk-theme: wrote {CONFIG} for theme {name or '(unnamed)'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
PY