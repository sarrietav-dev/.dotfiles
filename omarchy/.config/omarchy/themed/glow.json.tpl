{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{ foreground }}",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "{{ muted }}"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{ accent }}",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{ background }}",
    "background_color": "{{ accent }}",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "{{ muted }}",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "{{ muted }}",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "{{ blue }}",
    "underline": true
  },
  "link_text": {
    "color": "{{ cyan }}",
    "bold": true
  },
  "image": {
    "color": "{{ magenta }}",
    "underline": true
  },
  "image_text": {
    "color": "{{ muted }}"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{ orange }}",
    "background_color": "{{ mix background foreground 8% }}"
  },
  "code_block": {
    "color": "{{ foreground }}",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "{{ foreground }}"
      },
      "error": {
        "color": "{{ background }}",
        "background_color": "{{ red }}"
      },
      "comment": {
        "color": "{{ muted }}",
        "italic": true
      },
      "comment_preproc": {
        "color": "{{ orange }}"
      },
      "keyword": {
        "color": "{{ red }}"
      },
      "keyword_reserved": {
        "color": "{{ red }}",
        "bold": true
      },
      "keyword_namespace": {
        "color": "{{ magenta }}"
      },
      "keyword_type": {
        "color": "{{ yellow }}"
      },
      "operator": {
        "color": "{{ cyan }}"
      },
      "punctuation": {
        "color": "{{ light_foreground }}"
      },
      "name": {
        "color": "{{ foreground }}"
      },
      "name_builtin": {
        "color": "{{ cyan }}"
      },
      "name_tag": {
        "color": "{{ blue }}"
      },
      "name_attribute": {
        "color": "{{ blue }}"
      },
      "name_class": {
        "color": "{{ yellow }}",
        "bold": true
      },
      "name_constant": {
        "color": "{{ orange }}"
      },
      "name_decorator": {
        "color": "{{ orange }}"
      },
      "name_exception": {
        "color": "{{ red }}"
      },
      "name_function": {
        "color": "{{ green }}"
      },
      "literal_number": {
        "color": "{{ yellow }}"
      },
      "literal_date": {
        "color": "{{ muted }}"
      },
      "literal_string": {
        "color": "{{ green }}"
      },
      "literal_string_escape": {
        "color": "{{ cyan }}"
      },
      "generic_deleted": {
        "color": "{{ red }}"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "{{ green }}"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "{{ muted }}"
      },
      "background": {
        "background_color": "{{ mix background foreground 6% }}"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {
    "color": "{{ muted }}"
  },
  "html_span": {
    "color": "{{ muted }}"
  }
}
