# Herdr app rewrites its guide, type files and shipped assets on every start.
/AGENTS.md
/gpui-kit.d.ts
/herdr.d.ts
/frame/
/icons/
/installed.json

# Runtime state and local data.
/data/
/seen.json
/shared.json
/shared.json.corrupt-*
/telemetry/
/update-notes.json
/update-notes-cache.md
/update-notes-media/
/view.json
/window.json
/windows.json
/*.sock
/*.error
/*.reset-*

# Shipped layouts and their live click state.
/layouts/.state/
/layouts/main.json
/layouts/terminals.json
/layouts/win98.json
/layouts/win98.svg

# Shipped themes; omarchy.json is generated by the Omarchy theme-set hook.
/themes/atom-one-dark.json
/themes/win98.json
/themes/omarchy.json

# Shipped mods. Personal mods stay tracked unless they reuse a shipped name.
/mods/agents/
/mods/changes/
/mods/confirm/
/mods/files/
/mods/help/
/mods/machine-add/
/mods/menu/
/mods/new-menu/
/mods/pane/
/mods/peek/
/mods/picker/
/mods/prompt/
/mods/spaces/
/mods/tabs/
/mods/terminals-bar/
/mods/terminals-pane/
/mods/toast/
/mods/win98/
/mods/workspace-chrome/
/mods/workspace-status/
/mods/worktree/

# Generated beside any mod.
/mods/*/jsconfig.json
/mods/*/gpui-kit.d.ts
/mods/*/node_modules/
/mods/*/*.error
